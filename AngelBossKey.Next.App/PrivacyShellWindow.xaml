<Window x:Class="AngelBossKey.Next.App.PrivacyShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天使老板键 Next - 隐私桌面"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#151918" Foreground="#F4F7F5"
        AutomationProperties.Name="天使老板键隐私桌面">
    <Window.Resources>
        <Style x:Key="ShellButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7F5" />
            <Setter Property="Background" Value="#262D2B" />
            <Setter Property="BorderBrush" Value="#3B4743" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#32403B" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#58B99B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="92" />
        </Grid.RowDefinitions>

        <Grid Margin="28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="5" Background="#58B99B" Margin="0,0,12,0">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="17"
                               Foreground="#10201B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="天使老板键 Next" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="  /  隐私桌面" Foreground="#AAB5B1" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ShellButton}" Click="Return_Click"
                    AutomationProperties.Name="返回原桌面" ToolTip="返回原桌面">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="返回原桌面" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ClockText" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="64" FontWeight="Light" HorizontalAlignment="Center" />
            <TextBlock x:Name="DateText" FontSize="17" Foreground="#AAB5B1"
                       Margin="0,8,0,0" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#58B99B"
                       Margin="0,28,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="2" Background="#1D2321" BorderBrush="#35403C" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource ShellButton}" Tag="browse" Click="Launch_Click"
                        AutomationProperties.Name="打开程序" ToolTip="打开程序">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="打开程序" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ShellButton}" Tag="notepad" Click="Launch_Click"
                        AutomationProperties.Name="记事本" ToolTip="记事本">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="记事本" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ShellButton}" Tag="calculator" Click="Launch_Click"
                        AutomationProperties.Name="计算器" ToolTip="计算器">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="计算器" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ShellButton}" Tag="terminal" Click="Launch_Click"
                        AutomationProperties.Name="命令提示符" ToolTip="命令提示符">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="命令提示符" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
