<Window x:Class="AngelBossKey.Next.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="天使老板键 Next"
        Width="1080" Height="700" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="8" Margin="24,0,14,0"
                    Background="#24333B" VerticalAlignment="Center">
                <Grid>
                    <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}" />
                    <Path Data="M 11,21 C 13,15 19,13 24,17" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="天使老板键 Next" FontSize="19" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusTitle}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock Text=" · " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="12,0,10,0"
                    Click="SetHotkey_Click" MinWidth="144" ToolTip="设置全局隐藏热键"
                    AutomationProperties.Name="设置全局隐藏热键">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE765;" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding HotkeyText}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Margin="0,0,24,0"
                    MinWidth="118" Command="{Binding ToggleVisibilityCommand}"
                    AutomationProperties.Name="{Binding ToggleText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE890;" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ToggleText}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

        <Grid Grid.Row="2" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="目标程序" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding TargetCountText}" Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="AddTarget_Click"
                    AutomationProperties.Name="添加程序">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,8,0" />
                    <TextBlock Text="添加程序" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="3" Margin="24,0,24,20">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" />
            <TextBlock Text="尚未添加目标程序" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Targets.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid ItemsSource="{Binding Targets}" AutoGenerateColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="#F8FAFA" RowHeight="86" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single"
                      IsReadOnly="False" CanUserSortColumns="False">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="38" />
                        <Setter Property="Background" Value="#F8FAFA" />
                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="启用" Width="54">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="程序" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   MaxWidth="118" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPathValid}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TemporarilyExcluded}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="标题条件" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="包含" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TitleIncludes, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="留空时匹配该程序的全部窗口" Padding="6,3" />
                                    <TextBlock Grid.Row="1" Text="排除" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" Margin="0,5,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TitleExcludes, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="标题包含该文字的窗口不隐藏" Padding="6,3" Margin="0,5,0,0" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="可执行文件" Binding="{Binding ExecutablePath}" Width="*" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="临时排除" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding TemporarilyExcluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" ToolTip="仅本次运行不参与隐藏" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="116">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="上移"
                                            AutomationProperties.Name="上移规则"
                                            Command="{Binding DataContext.MoveTargetUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="下移" Margin="4,0"
                                            AutomationProperties.Name="下移规则"
                                            Command="{Binding DataContext.MoveTargetDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="移除目标"
                                            AutomationProperties.Name="移除目标"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource BorderBrush}" />
        <Grid Grid.Row="5" Background="{StaticResource SurfaceBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Message}" Margin="24,0" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE838;"
                    ToolTip="打开诊断日志目录" AutomationProperties.Name="打开诊断日志目录"
                    Click="OpenLogs_Click" Margin="0,0,16,0" />
            <CheckBox Grid.Column="2" Content="开机启动" IsChecked="{Binding LaunchAtLogin}"
                      Margin="16,0,24,0" />
            <CheckBox Grid.Column="3" Content="关闭到托盘" IsChecked="{Binding CloseToTray}"
                      Margin="0,0,24,0" />
        </Grid>
    </Grid>
</Window>
