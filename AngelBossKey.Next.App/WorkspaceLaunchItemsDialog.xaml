<Window x:Class="AngelBossKey.Next.App.WorkspaceLaunchItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作区启动项" Width="920" Height="560" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="工作区启动程序" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LaunchItemCountText}" Margin="0,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding WorkspaceStatusText}" Margin="0,3,0,0"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="捕获运行中程序"
                    Margin="8,0" Click="Capture_Click" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="关闭工作区"
                    Margin="0,0,8,0" Click="CloseWorkspace_Click" />
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="添加程序"
                    Click="Add_Click" />
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding LaunchItems}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="66"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                    <DataGridTemplateColumn Header="程序" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" Padding="5,2" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="2,4,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="可执行文件" Binding="{Binding ExecutablePath}" Width="*" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="参数" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=LostFocus}" Padding="5,2"
                                         ToolTip="直接传给程序，不经过命令行 Shell" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="工作目录" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=LostFocus}" Padding="5,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding DataContext.RemoveLaunchItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="移除启动项" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="返回原桌面不会关闭这些程序；关闭工作区或退出 Next 才会结束它们。"
                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <Button Content="完成" Width="88" HorizontalAlignment="Right" IsCancel="True"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</Window>
